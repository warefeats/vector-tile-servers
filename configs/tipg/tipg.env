# TiPg 1.5.0. Environment is the only configuration surface.
DATABASE_URL=postgresql://tiles:tiles@db:5432/bench
TIPG_DB_SCHEMAS=["bench"]
TIPG_DB_ONLY_SPATIAL_TABLES=true
TIPG_FALLBACK_KEY_NAMES=["fid"]
TIPG_TILE_RESOLUTION=4096
TIPG_TILE_BUFFER=64
TIPG_TILE_CLIP=true
TIPG_MAX_FEATURES_PER_TILE=1000000
TIPG_SET_MVT_LAYERNAME=true
TIPG_ADD_TILES_VIEWER=false
TIPG_DEBUG=false
# 4 gunicorn workers x 2 connections = the same 8-connection pool as every other server.
WEB_CONCURRENCY=4
DB_MIN_CONN_SIZE=1
DB_MAX_CONN_SIZE=2
PORT=8080
